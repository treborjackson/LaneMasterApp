generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences  UserPreferences?
  games        GameSession[]
  ballNotes    BallNote[]
  formAnalyses FormAnalysis[]

  @@map("users")
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bowlingStyle   String @default("onehand")
  skillLevel     String @default("beginner")
  handedness     String @default("right")
  goals          String @default("[]")
  favoriteBrands String @default("[]")
  selectedBall   String?

  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model GameSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  datePlayed    DateTime @default(now())
  totalScore    Int      @default(0)
  ballUsed      String?
  laneNumber    Int?
  oilPattern    String?
  bowlingAlley     String?  @map("bowling_alley")
  stance           String?
  targetArrow      String?  @map("target_arrow")
  boardAdjustments String?  @map("board_adjustments")

  frames String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("game_sessions")
}

model BallNote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ballName  String
  brand     String
  rating    Int      @default(0)
  notes     String   @default("")
  dateAdded DateTime @default(now())

  @@unique([userId, ballName])
  @@map("ball_notes")
}

model BallsOfMonth {
  id        String   @id @default(cuid())
  picks     String   @default("[]")
  sources   String   @default("[]")
  createdAt DateTime @default(now())

  @@map("balls_of_month")
}

model Invite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@map("invites")
}

model CoachMemory {
  id        String   @id @default(cuid())
  userId    String   @unique
  summary   String   @default("")
  updatedAt DateTime @updatedAt

  @@map("coach_memories")
}

model FormAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisType String
  proCompared  String?
  score        Int    @default(0)
  resultJson   String @default("{}")

  createdAt DateTime @default(now())

  @@map("form_analyses")
}
